# Copy to .env only if you must; prefer your shell's secret store or a password manager.
# Nothing in this file is needed for `make demo`.

# Passphrase for the encrypted token vault (used only when no OS keychain is available).
# 12+ characters. Never commit the real value.
FAIRCLIP_VAULT_PASSPHRASE=

# Path to fairclip.toml (default: ./fairclip.toml)
FAIRCLIP_CONFIG=fairclip.toml
